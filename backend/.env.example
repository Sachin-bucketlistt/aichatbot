# Copy this file to .env and fill in your own values. Never commit a real .env.

# Required: your provider API key. litellm reads this for the default
# gpt-4o-mini model (OpenAI). If you switch LLM_MODEL to a different
# provider, set that provider's key env var instead (see README).
OPENAI_API_KEY=sk-your-key-here

# Any model string litellm understands, e.g. gpt-4o-mini, gpt-4o,
# claude-3-5-sonnet-20241022, gemini/gemini-1.5-pro, ollama/llama3, etc.
# Swapping providers/models is just changing this one value - no code changes.
LLM_MODEL=gpt-4o-mini

# Path (relative to the backend/ working directory) to the knowledge-base /
# system-prompt file. Point this at a different file to repurpose the bot
# (e.g. data/employee_policy_kb.md for an internal Q&A bot).
SYSTEM_PROMPT_FILE=data/knowledge_base.md

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# Port uvicorn serves on.
PORT=8000

# ─── Weaviate Vector DB (RAG) ────────────────────────────────────────────────
# Optional. Run `python scripts/upsert_to_weaviate.py` after setting these to
# populate the KB. If left blank, the chatbot falls back to the flat
# knowledge_base.md file.
#
# Self-hosted (default via `docker compose up`, runs the `weaviate` service
# from docker-compose.yml with anonymous access — no API key needed):
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
#
# Or Weaviate Cloud instead — create a free cluster at
# https://console.weaviate.cloud and set both:
# WEAVIATE_URL=https://your-cluster.weaviate.network
# WEAVIATE_API_KEY=your-weaviate-admin-api-key

# ─── bucketlistt MCP (live catalog data) ─────────────────────────────────────
# Optional. Adds live destinations/activities/slots tools from bucketlistt's
# own MCP server (see app/mcp_client.py). Only read-only catalog tools are
# loaded — auth, cart, and payment tools are never exposed to the model.
# If left blank, the chatbot just doesn't get these tools.
MCP_SERVER_URL=https://mcp.bucketlistt.com/mcp

# ─── Redis ────────────────────────────────────────────────────────────────
# Optional, shared by two things:
#  - app/cache.py: caches read-only MCP catalog results for 2h (never live
#    availability or per-user data — see CACHEABLE_TOOLS in mcp_client.py)
#  - app/session_store.py: persists chat history per session and triggers
#    the login-details prompt after LOGIN_PROMPT_AFTER user messages
# Blank = both features skipped, same as today.
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=7200
LOGIN_PROMPT_AFTER=3

# Past this many user messages in one session, the backend stops calling the
# LLM and replies with a friendly "start a new chat" message instead - no
# effect without REDIS_URL set (message counting lives in the same session
# store above).
MAX_MESSAGES_PER_SESSION=15

# ─── Employee dashboard summaries ────────────────────────────────────────────
# Optional. When a session goes quiet for IDLE_SUMMARY_MINUTES, app/dashboard.py
# asks Claude for a structured summary (topics, questions asked, sentiment,
# contact info) and appends it to data/session_summaries.json. Pull it via
# GET /api/admin/session-summaries with `Authorization: Bearer <DASHBOARD_API_KEY>`.
# Blank DASHBOARD_API_KEY = those endpoints return 503 (the idle scan itself
# still runs and stores summaries either way — only reads are gated).
DASHBOARD_API_KEY=
IDLE_SUMMARY_MINUTES=15

# Optional push delivery: POST each summary to an external system as soon as
# it's generated (in addition to the pull endpoints above, which still work
# as a backfill for anything a failed delivery missed). Blank URL = off.
# Request is signed with HMAC-SHA256 in X-Webhook-Signature: t=<unix>,v1=<hex
# of hmac(secret, "<t>.<body>")> — verify it, and reject stale timestamps, to
# block replay. Leave SUMMARY_WEBHOOK_SECRET blank to send unsigned (fine for
# a private network, not recommended over the public internet).
SUMMARY_WEBHOOK_URL=
SUMMARY_WEBHOOK_SECRET=

# ─── SMTP alerts (out-of-credits notifications, see SMTP_ALERTS.md) ─────────
# Optional. If left blank, the backend logs a warning instead of emailing.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-bot-email@gmail.com
SMTP_PASS=your-secure-app-password
SMTP_TO=admin@bucketlistt.com

# ─── Machine-to-machine callers (e.g. WhatsApp CRM) ──────────────────────────
# Blank = /api/chat open as before (browser frontend can't hold a secret).
# Set on a dedicated deployment to require `Authorization: Bearer <key>` on
# /api/chat and /api/session/user-info; valid-key calls skip the rate limit.
CHAT_API_KEY=
CHAT_LIMIT_PER_MINUTE=20
